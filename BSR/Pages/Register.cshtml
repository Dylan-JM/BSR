@page
@model BSR.Pages.Register

<partial name="_AlertMessages" />

<div class="h-100">
    <div class="mask d-flex align-items-center h-100">
        <div class="container">
            <div class="row justify-content-center p-5">
                <div class="col">
                    <div class="card shadow-2-strong" style="background-color: #f5f7fa;">
                        <div class="card-body">
                             <form id="account" method="post" asp-page-handler="Register">
                                <div class="form-floating" style="margin:10px">
                                    <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="E-mail">
                                    <label asp-for="Input.Email" class="form-label"></label>
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>
                                <div class="form-floating" style="margin:10px">
                                    <input asp-for="Input.Password" class="form-control" autocomplete="password" aria-required="true" placeholder="Password">
                                    <label asp-for="Input.Password" class="form-label"></label>
                                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                                </div>
                                <div style="margin:10px">
                                    <button id="register-submit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                                </div>
                                <div class="form-floating" style="margin:10px">Already have an account? <a href="Login">Log In</a></div>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="col d-flex justify-content-center mb-2">
                        <h2>Or Register With Your Microsoft Account</h2>
                    </div>
                    <div class="col d-flex justify-content-center">
                        @{
                            <form id="external-account" method="post" asp-page-handler="ExternalLogin" class="form-horizontal">
                                <div>
                                    <p>
                                    <button type="submit" class="btn btn-dark btn-lg border-dark rounded">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="128" height="128" fill="currentColor" class="bi bi-microsoft" viewBox="0 0 16 16">
                                    <path d="M7.462 0H0v7.19h7.462zM16 0H8.538v7.19H16zM7.462 8.211H0V16h7.462zm8.538 0H8.538V16H16z"/>
                                    </svg>
                                    </button>
                                    </p>
                                </div>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>