@using BSR.Models
@model Home

@if (TempData["SuccessMessage"] != null){
	<div class="alert alert-success mt-3 " role="alert">
		@TempData["SuccessMessage"]
	</div>
}

@if (TempData["ErrorMessage"] != null){
	<div class="alert alert-danger mt-3" role="alert">
		@TempData["ErrorMessage"]
	</div>
}

<a class="btn btn-outline-dark mt-3 mb-3" asp-controller="Homes" asp-action="Index">Back to Home List</a>


<h2>Add a New Home</h2>

<form class="pb=3" asp-action="AddHome" asp-controller="Homes" method="post">
	<div asp-validation-summary="All" class="text-danger"></div>
	<div class="form-group pb-3 w-25">
		<label>Price</label>
		<input asp-for="Price" class="form-control"/>
	</div>
	<div class="form-group pb-3 w-50">
		<label>Address</label>
		<input asp-for="Address" class="form-control"/>
	</div>
	<div class="form-group pb-3 w-25">
		<label>Square Meters</label>
		<input asp-for="Area" class="form-control"/>
	</div>
	<input type="submit" value="Add Home" class="btn btn-success"/>
</form>